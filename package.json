{
  "name": "geo-lab",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.13"
  },
  "description": "GEO Lab — Generative Engine Optimization Laboratory",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "npx --yes netlify-cli dev",
    "search:index": "pagefind --site dist",
    "benchmark:reset": "node scripts/reset-benchmark.mjs",
    "check": "astro check",
    "check:site": "node scripts/check-site.mjs",
    "test:store": "node scripts/test-store.mjs",
    "verify": "astro build && pagefind --site dist && node scripts/check-site.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.6",
    "@astrojs/netlify": "^6.6.5",
    "@astrojs/react": "^4.4.1",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.6.0",
    "@tailwindcss/vite": "^4.1.14",
    "astro": "^5.14.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "pagefind": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
