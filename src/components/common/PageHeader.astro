---
type Props = {
  eyebrow: string;
  title: string;
  titleEn?: string;
  description: string;
  crumb: { name: string; href: string }[];
  stats?: { label: string; value: string }[];
};

import Breadcrumbs from '@/components/common/Breadcrumbs.astro';

const { eyebrow, title, titleEn, description, crumb, stats } = Astro.props;
---

<section class="relative overflow-hidden border-b border-line">
  <div class="pointer-events-none absolute inset-0 grid-backdrop opacity-70"></div>
  <div class="relative mx-auto max-w-6xl px-5 pb-12 pt-10 sm:px-8 sm:pb-14 sm:pt-12">
    <Breadcrumbs items={crumb} />
    <div class="mt-7 flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="display-title mt-2 text-3xl sm:text-[2.6rem]">{title}</h1>
        {titleEn && <p class="mt-2 font-display text-base text-brand-600 italic">{titleEn}</p>}
        <p class="lede mt-4">{description}</p>
      </div>
      {
        stats && stats.length > 0 && (
          <dl class="flex flex-wrap gap-x-8 gap-y-4 border-t border-line pt-4 lg:border-0 lg:pt-0">
            {stats.map((stat) => (
              <div>
                <dt class="font-mono text-[10px] tracking-[0.12em] text-muted uppercase">{stat.label}</dt>
                <dd class="mt-0.5 font-display text-xl text-ink">{stat.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </div>
</section>
