---
type Crumb = { name: string; href: string };

type Props = {
  items: Crumb[];
};

const { items } = Astro.props;
---

<nav aria-label="面包屑" class="flex flex-wrap items-center gap-1.5 text-xs text-muted">
  <a href="/" class="hover:text-brand-700">首页</a>
  {
    items.map((item, index) => (
      <>
        <span aria-hidden="true" class="text-line-strong">
          /
        </span>
        {index === items.length - 1 ? (
          <span class="text-ink-soft" aria-current="page">
            {item.name}
          </span>
        ) : (
          <a href={item.href} class="hover:text-brand-700">
            {item.name}
          </a>
        )}
      </>
    ))
  }
</nav>
