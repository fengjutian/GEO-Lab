---
import EvidenceBadge from '@/components/common/EvidenceBadge.astro';
import { formatDate } from '@/lib/utils/format';
import type { EvidenceLevel } from '@/lib/seo/site';

type Props = {
  title: string;
  description: string;
  href: string;
  category?: string;
  date?: Date;
  evidence?: EvidenceLevel;
  tags?: string[];
  readingTime?: number;
  label?: string;
  variant?: 'default' | 'compact' | 'featured';
};

const {
  title,
  description,
  href,
  category,
  date,
  evidence,
  tags = [],
  readingTime,
  label,
  variant = 'default',
} = Astro.props;
---

{
  variant === 'featured' ? (
    <a href={href} class="group block rounded-[var(--radius-card)] border border-line bg-canvas p-7 transition-colors hover:border-brand-300 sm:p-9">
      <div class="flex flex-wrap items-center gap-2">
        {label && <span class="chip chip-brand">{label}</span>}
        {category && <span class="chip">{category}</span>}
        {evidence && <EvidenceBadge level={evidence} compact />}
      </div>
      <h3 class="display-title mt-5 text-2xl text-ink group-hover:text-brand-800 sm:text-[1.75rem]">
        {title}
      </h3>
      <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-muted">{description}</p>
      <div class="mt-6 flex items-center gap-3 font-mono text-[11px] tracking-wide text-muted uppercase">
        {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
        {readingTime && <span aria-hidden="true">·</span>}
        {readingTime && <span>{readingTime} min read</span>}
      </div>
    </a>
  ) : (
    <a
      href={href}
      class="group flex h-full flex-col rounded-[var(--radius-card)] border border-line bg-canvas p-5 transition-all hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-[var(--shadow-card)]"
    >
      <div class="flex flex-wrap items-center gap-2">
        {category && <span class="chip">{category}</span>}
        {evidence && <EvidenceBadge level={evidence} compact />}
      </div>
      <h3 class="mt-3 text-[15px] font-semibold leading-snug text-ink group-hover:text-brand-800">
        {title}
      </h3>
      {variant !== 'compact' && (
        <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted">{description}</p>
      )}
      <div class="mt-auto flex flex-wrap items-center gap-x-2 gap-y-1 pt-4 font-mono text-[10px] tracking-wide text-muted uppercase">
        {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
        {tags.slice(0, 2).map((tag) => (
          <span>#{tag}</span>
        ))}
      </div>
    </a>
  )
}
