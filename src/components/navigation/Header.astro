---
import { NAV } from '@/lib/seo/site';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href.replace(/\/$/, ''));
---

<header class="sticky top-0 z-50 border-b border-line bg-canvas/85 backdrop-blur-md" data-pagefind-ignore>
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-5 sm:px-8">
    <a href="/" class="group flex items-center gap-2.5" aria-label="GEO Lab 首页">
      <span
        class="flex size-8 items-center justify-center rounded-md bg-brand-800 text-[11px] font-semibold tracking-wider text-white"
      >
        GL
      </span>
      <span class="flex flex-col leading-none">
        <span class="text-[15px] font-semibold tracking-tight text-ink">GEO Lab</span>
        <span class="mt-1 font-mono text-[9px] tracking-[0.18em] text-muted uppercase">
          Research · Optimize
        </span>
      </span>
    </a>

    <nav class="hidden flex-1 items-center gap-0.5 lg:flex" aria-label="主导航">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'relative rounded-md px-2.5 py-2 text-sm transition-colors',
              isActive(item.href)
                ? 'font-medium text-brand-800'
                : 'text-ink-soft hover:bg-surface hover:text-brand-800',
            ]}
          >
            {item.title}
            {isActive(item.href) && (
              <span class="absolute inset-x-3 -bottom-px h-px bg-brand-700" />
            )}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2 md:ml-0">
      <a
        href="/search/"
        class="hidden items-center gap-1.5 rounded-md px-3 py-2 text-sm text-ink-soft transition-colors hover:bg-surface hover:text-brand-800 sm:flex"
        data-pagefind-ignore
      >
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.4"></circle>
          <path d="M10.5 10.5 14 14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
        </svg>
        搜索
      </a>
      <a href="/services/" class="btn btn-primary hidden sm:inline-flex">开始 GEO 诊断</a>

      <details class="relative lg:hidden">
        <summary
          class="flex size-9 cursor-pointer list-none items-center justify-center rounded-md border border-line text-ink-soft [&::-webkit-details-marker]:hidden"
          aria-label="打开导航菜单"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
          </svg>
        </summary>
        <div
          class="absolute right-0 top-11 w-56 overflow-hidden rounded-xl border border-line bg-canvas p-1.5 shadow-[var(--shadow-float)]"
        >
          {
            NAV.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'flex items-baseline justify-between rounded-md px-3 py-2 text-sm',
                  isActive(item.href) ? 'bg-brand-50 text-brand-800' : 'text-ink-soft',
                ]}
              >
                <span>{item.title}</span>
                <span class="font-mono text-[10px] tracking-wider text-muted uppercase">
                  {item.titleEn}
                </span>
              </a>
            ))
          }
          <a href="/search/" class="flex items-baseline justify-between rounded-md px-3 py-2 text-sm text-ink-soft">
            <span>搜索</span>
            <span class="font-mono text-[10px] tracking-wider text-muted uppercase">Search</span>
          </a>
        </div>
      </details>
    </div>
  </div>
</header>
