---
import MainLayout from '@/layouts/MainLayout.astro';
import PageHeader from '@/components/common/PageHeader.astro';
import EvidenceBadge from '@/components/common/EvidenceBadge.astro';
import { getCases, readingTime } from '@/lib/content/queries';
import { formatDate } from '@/lib/utils/format';
import { breadcrumbSchema } from '@/lib/schema/jsonld';

const cases = await getCases();

const scopeLabels = {
  'technical-audit': '结构检查',
  'content-audit': '内容检查',
  'visibility-test': '可见性测试',
} as const;

const schemas = [
  breadcrumbSchema([
    { name: '首页', url: '/' },
    { name: '案例库', url: '/cases/' },
  ]),
];
---

<MainLayout
  title="案例库"
  description="GEO Lab 的诊断与优化案例：技术结构检查、内容可理解性改写、AI 可见性测试。每个案例标明检查范围，不把结构检查的结果包装成 AI 引用效果。"
  canonical="/cases/"
  schemas={schemas}
>
  <PageHeader
    eyebrow="Cases"
    title="案例库"
    titleEn="What we checked, what we changed, what we did not prove."
    description="案例按检查范围分为三类。我们只报告实际测过的内容：结构检查不会写成引用率提升，演示数据不会伪装成客户项目。"
    crumb={[{ name: '案例库', href: '/cases/' }]}
    stats={[{ label: 'Cases', value: String(cases.length) }]}
  />

  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
    <div class="grid gap-3 rounded-xl border border-accent-300 bg-accent-100/60 p-5 sm:grid-cols-[auto_1fr] sm:gap-5">
      <p class="font-mono text-[10px] tracking-[0.14em] text-accent-700 uppercase">阅读说明</p>
      <p class="text-[13px] leading-relaxed text-ink-soft">
        案例中的站点与数据要么是公开可查的示例，要么明确标注为演示。GEO Lab 不会用无法核验的客户数据说明效果；涉及 AI 可见性的结论必须来自可见性测试，而不是页面结构分析。
      </p>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {
        cases.map((entry) => (
          <a
            href={`/cases/${entry.id}/`}
            class="group flex flex-col rounded-[var(--radius-card)] border border-line bg-canvas p-6 transition-all hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-[var(--shadow-card)]"
          >
            <div class="flex flex-wrap items-center gap-2">
              <span class="chip chip-brand">{entry.data.category}</span>
              <span class="chip !text-[11px]">{scopeLabels[entry.data.scope]}</span>
              <EvidenceBadge level={entry.data.evidence} compact />
            </div>
            <h2 class="mt-4 text-lg font-semibold leading-snug text-ink group-hover:text-brand-800">
              {entry.data.title}
            </h2>
            <p class="mt-2 flex-1 text-[13px] leading-relaxed text-muted">{entry.data.description}</p>
            <dl class="mt-5 grid grid-cols-2 gap-3 border-t border-line pt-4 text-[11px]">
              {entry.data.site && (
                <div>
                  <dt class="font-mono text-[9px] tracking-[0.1em] text-muted uppercase">站点</dt>
                  <dd class="mt-0.5 truncate text-ink-soft">{entry.data.site}</dd>
                </div>
              )}
              {entry.data.timeframe && (
                <div>
                  <dt class="font-mono text-[9px] tracking-[0.1em] text-muted uppercase">周期</dt>
                  <dd class="mt-0.5 text-ink-soft">{entry.data.timeframe}</dd>
                </div>
              )}
            </dl>
            <p class="mt-4 font-mono text-[10px] tracking-wide text-muted uppercase">
              {formatDate(entry.data.publishDate)} · {readingTime(entry)} min read
            </p>
          </a>
        ))
      }
    </div>
  </div>
</MainLayout>
