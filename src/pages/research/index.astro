---
import MainLayout from '@/layouts/MainLayout.astro';
import PageHeader from '@/components/common/PageHeader.astro';
import SectionHeader from '@/components/common/SectionHeader.astro';
import EvidenceBadge from '@/components/common/EvidenceBadge.astro';
import { getResearch, readingTime } from '@/lib/content/queries';
import { formatDate } from '@/lib/utils/format';
import { breadcrumbSchema } from '@/lib/schema/jsonld';

const research = await getResearch();
const categories = ['论文解读', '实验报告', '技术趋势', '开源研究'];
const featured = research.find((entry) => entry.data.featured) ?? research[0];
const rest = research.filter((entry) => entry.id !== featured?.id);

const schemas = [
  breadcrumbSchema([
    { name: '首页', url: '/' },
    { name: '技术研究', url: '/research/' },
  ]),
];
---

<MainLayout
  title="技术研究"
  description="GEO 相关的论文解读、可复现实验、技术趋势与开源工具研究。GEO Lab 公开测试条件、样本规模与结论边界，保留失败记录。"
  canonical="/research/"
  schemas={schemas}
>
  <PageHeader
    eyebrow="Research"
    title="技术研究"
    titleEn="Papers, experiments and what the evidence actually supports."
    description="研究记录分四类：论文解读、实验报告、技术趋势、开源研究。凡是实验，都写明模型版本、时间、问题集与样本量；凡是协议，都不冒称结果。"
    crumb={[{ name: '技术研究', href: '/research/' }]}
    stats={[
      { label: 'Records', value: String(research.length) },
      { label: 'Categories', value: '4' },
    ]}
  />

  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_260px]">
      <div>
        {
          featured && (
            <a
              href={`/research/${featured.id}/`}
              class="group block rounded-[var(--radius-card)] border border-line bg-canvas p-7 transition-colors hover:border-brand-300 sm:p-9"
            >
              <div class="flex flex-wrap items-center gap-2">
                <span class="chip chip-accent">重点研究</span>
                <span class="chip">{featured.data.category}</span>
                <EvidenceBadge level={featured.data.evidence} compact />
              </div>
              <h2 class="display-title mt-5 text-2xl group-hover:text-brand-800 sm:text-[1.75rem]">
                {featured.data.title}
              </h2>
              <p class="mt-3 text-[15px] leading-relaxed text-muted">{featured.data.description}</p>
              <dl class="mt-6 flex flex-wrap gap-x-6 gap-y-2 border-t border-line pt-4 font-mono text-[10px] tracking-wide text-muted uppercase">
                <div class="flex gap-1.5">
                  <dt>发布</dt>
                  <dd>{formatDate(featured.data.publishDate)}</dd>
                </div>
                <div class="flex gap-1.5">
                  <dt>阅读</dt>
                  <dd>{readingTime(featured)} min</dd>
                </div>
                {featured.data.sampleSize && (
                  <div class="flex gap-1.5">
                    <dt>样本</dt>
                    <dd>{featured.data.sampleSize}</dd>
                  </div>
                )}
              </dl>
            </a>
          )
        }

        <section class="mt-12">
          <SectionHeader eyebrow="Archive" title="研究档案" />
          <ul class="mt-6 divide-y divide-line border-y border-line">
            {
              rest.map((entry) => (
                <li>
                  <a
                    href={`/research/${entry.id}/`}
                    class="group grid gap-3 py-6 sm:grid-cols-[140px_minmax(0,1fr)_auto] sm:items-start sm:gap-6"
                  >
                    <div class="flex flex-col gap-1.5">
                      <span class="font-mono text-[10px] tracking-wide text-muted uppercase">
                        {entry.data.category}
                      </span>
                      <time class="font-mono text-[10px] text-muted" datetime={entry.data.publishDate.toISOString()}>
                        {formatDate(entry.data.publishDate)}
                      </time>
                    </div>
                    <div>
                      <h3 class="text-[15px] font-medium leading-snug text-ink group-hover:text-brand-800">
                        {entry.data.title}
                      </h3>
                      <p class="mt-1.5 text-[13px] leading-relaxed text-muted">{entry.data.description}</p>
                    </div>
                    <div class="flex items-center gap-2 sm:flex-col sm:items-end">
                      <EvidenceBadge level={entry.data.evidence} compact />
                      {entry.data.models.length > 0 && (
                        <span class="font-mono text-[10px] text-muted">{entry.data.models.length} 模型</span>
                      )}
                    </div>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </div>

      <aside class="space-y-6">
        <div class="rounded-xl border border-line bg-surface p-5">
          <p class="eyebrow">分类</p>
          <ul class="mt-3 space-y-2">
            {
              categories.map((category) => {
                const count = research.filter((entry) => entry.data.category === category).length;
                return (
                  <li class="flex items-center justify-between text-[13px]">
                    <span class="text-ink-soft">{category}</span>
                    <span class="font-mono text-[10px] text-muted">{count}</span>
                  </li>
                );
              })
            }
          </ul>
        </div>

        <div class="rounded-xl border border-line p-5">
          <p class="eyebrow">研究规范</p>
          <ul class="mt-3 space-y-2.5 text-[12px] leading-relaxed text-muted">
            <li>每条结论标注证据等级。</li>
            <li>实验公开模型版本、时间与问题集。</li>
            <li>失败实验同样保留记录。</li>
            <li>不把单次结果当成稳定规律。</li>
          </ul>
          <a href="/about/#method" class="mt-4 inline-block text-xs text-brand-700 link-underline">完整方法论</a>
        </div>

        <div id="benchmark" class="rounded-xl border border-brand-200 bg-brand-50 p-5">
          <span class="chip !border-brand-300 !bg-canvas !text-[10px] !text-brand-700">V2 路线</span>
          <h2 class="mt-3 text-sm font-semibold text-brand-900">GEO Benchmark</h2>
          <p class="mt-2 text-[12px] leading-relaxed text-brand-900/70">
            固定问题集 + 多模型横评，记录品牌提及、引用来源与答案准确率。当前先发布实验协议，结果出来再发布数据。
          </p>
        </div>
      </aside>
    </div>
  </div>
</MainLayout>
