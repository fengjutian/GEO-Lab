---
import { render } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { getResearch, readingTime } from '@/lib/content/queries';
import { TOOLS } from '@/lib/tools/registry';

export async function getStaticPaths() {
  const research = await getResearch();
  return research.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, all: research },
  }));
}

const { entry, all } = Astro.props;
const { Content, headings } = await render(entry);

const studyFacts: { label: string; value: string }[] = [];
if (entry.data.methodology) studyFacts.push({ label: '方法', value: entry.data.methodology });
if (entry.data.sampleSize) studyFacts.push({ label: '样本', value: entry.data.sampleSize });
if (entry.data.testedAt) studyFacts.push({ label: '测试时间', value: entry.data.testedAt });
if (entry.data.models.length > 0)
  studyFacts.push({ label: '测试模型', value: entry.data.models.join('、') });

const related = entry.data.related
  .map((id) =>
    all.find((candidate) => candidate.id === id) ?? null,
  )
  .filter((candidate): candidate is (typeof all)[number] => Boolean(candidate))
  .map((candidate) => ({
    title: candidate.data.title,
    href: `/research/${candidate.id}/`,
    description: candidate.data.description,
  }));

const toolLinks = entry.data.tools
  .map((slug) => TOOLS.find((tool) => tool.slug === slug))
  .filter((tool): tool is (typeof TOOLS)[number] => Boolean(tool))
  .map((tool) => ({ title: tool.title, href: tool.href, description: tool.description }));
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  publishDate={entry.data.publishDate}
  updatedDate={entry.data.updatedDate}
  author={entry.data.author}
  category={entry.data.category}
  categoryHref="/research/"
  sectionLabel="技术研究"
  sectionHref="/research/"
  tags={entry.data.tags}
  evidence={entry.data.evidence}
  readingTime={readingTime(entry)}
  headings={headings}
  references={entry.data.references}
  related={related}
  toolLinks={toolLinks}
  studyFacts={studyFacts}
>
  <Content />
</ArticleLayout>
