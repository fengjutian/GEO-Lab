---
import MainLayout from '@/layouts/MainLayout.astro';
import SectionHeader from '@/components/common/SectionHeader.astro';
import ArticleCard from '@/components/articles/ArticleCard.astro';
import HeroDiagram from '@/components/home/HeroDiagram.astro';
import { getCases, getKnowledge, getResearch, readingTime } from '@/lib/content/queries';
import { TOOLS } from '@/lib/tools/registry';
import { EVIDENCE_LEVELS, SITE } from '@/lib/seo/site';
import { breadcrumbSchema } from '@/lib/schema/jsonld';

const [knowledge, research, cases] = await Promise.all([getKnowledge(), getResearch(), getCases()]);

const latestKnowledge = knowledge.slice(0, 3);
const latestResearch = research.slice(0, 2);
const latestCases = cases.slice(0, 2);

const pillars = [
  {
    en: 'Knowledge',
    title: '系统学习 GEO 技术',
    description: '从 AI 搜索原理、RAG、Embedding 到引用机制，按技术依赖顺序组织的知识库。',
    href: '/knowledge/',
    meta: `${knowledge.length} 篇技术文章`,
  },
  {
    en: 'Research',
    title: '论文与实验记录',
    description: '论文解读、可复现实验与技术趋势，公开测试条件和样本规模。',
    href: '/research/',
    meta: `${research.length} 份研究记录`,
  },
  {
    en: 'Tools',
    title: '浏览器端 GEO 工具',
    description: '网站诊断、切分实验、语义相似度、实体提取，全部在本地运行。',
    href: '/tools/',
    meta: `${TOOLS.filter((t) => t.status !== 'planned').length} 个可用工具`,
  },
  {
    en: 'Benchmark',
    title: '可见性基准（规划中）',
    description: '固定问题集 + 多模型横评，记录引用位置、来源质量与答案准确度。',
    href: '/research/#benchmark',
    meta: 'V2 路线',
  },
];

const pipeline = [
  '用户提问',
  '查询理解',
  '网页检索',
  '内容排序',
  '上下文构建',
  '答案生成',
  '来源引用',
];

const schemas = [
  breadcrumbSchema([{ name: '首页', url: '/' }]),
];
---

<MainLayout
  title={SITE.name}
  description={SITE.description}
  canonical="/"
  schemas={schemas}
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-line">
    <div class="pointer-events-none absolute inset-0 grid-backdrop"></div>
    <div class="relative mx-auto max-w-6xl px-5 pb-16 pt-14 sm:px-8 sm:pb-20 sm:pt-20">
      <div class="grid items-center gap-12 lg:grid-cols-[1.15fr_0.85fr]">
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <span class="chip chip-brand">GEO 研究门户</span>
            <span class="font-mono text-[10px] tracking-[0.18em] text-muted uppercase">
              Knowledge · Research · Tools
            </span>
          </div>

          <h1 class="display-title mt-6 text-[2.6rem] leading-[1.06] sm:text-6xl">
            让 AI 看见<br class="sm:hidden" />你的内容。
          </h1>
          <p class="mt-4 font-display text-lg text-brand-700 italic sm:text-xl">
            {SITE.taglineEn}
          </p>

          <p class="lede mt-6 max-w-xl">
            GEO Lab 研究 AI 如何发现、理解、检索和引用互联网内容。我们把研究结论做成可交互的实验工具，并翻译成企业可以执行的 GEO 诊断与优化方案。
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href="/knowledge/" class="btn btn-primary">从知识库开始</a>
            <a href="/tools/site-audit/" class="btn btn-ghost">运行 GEO 诊断 →</a>
          </div>

          <dl class="mt-10 grid max-w-lg grid-cols-3 gap-4 border-t border-line pt-6">
            <div>
              <dt class="font-mono text-[10px] tracking-[0.12em] text-muted uppercase">Articles</dt>
              <dd class="mt-1 font-display text-2xl text-ink">{knowledge.length}</dd>
            </div>
            <div>
              <dt class="font-mono text-[10px] tracking-[0.12em] text-muted uppercase">Tools</dt>
              <dd class="mt-1 font-display text-2xl text-ink">{TOOLS.length}</dd>
            </div>
            <div>
              <dt class="font-mono text-[10px] tracking-[0.12em] text-muted uppercase">Evidence</dt>
              <dd class="mt-1 font-display text-2xl text-ink">{Object.keys(EVIDENCE_LEVELS).length} 级</dd>
            </div>
          </dl>
        </div>

        <HeroDiagram />
      </div>
    </div>
  </section>

  <!-- 四个方向 -->
  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <SectionHeader
      eyebrow="Platform"
      title="研究、工具与服务在同一个闭环里"
      description="知识库解释机制，实验室让人动手验证，研究记录公开证据，企业服务把结论落地。"
    />
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        pillars.map((pillar) => (
          <a
            href={pillar.href}
            class="group flex flex-col rounded-[var(--radius-card)] border border-line bg-canvas p-5 transition-all hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-[var(--shadow-card)]"
          >
            <span class="font-mono text-[10px] tracking-[0.16em] text-brand-600 uppercase">
              {pillar.en}
            </span>
            <h3 class="mt-2 text-[15px] font-semibold text-ink group-hover:text-brand-800">
              {pillar.title}
            </h3>
            <p class="mt-2 flex-1 text-[13px] leading-relaxed text-muted">{pillar.description}</p>
            <span class="mt-4 border-t border-line pt-3 font-mono text-[10px] tracking-wide text-muted uppercase">
              {pillar.meta}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- AI 搜索原理条 -->
  <section class="border-y border-line bg-surface">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <div>
          <p class="eyebrow">Core Concept</p>
          <h2 class="display-title mt-2 text-2xl sm:text-3xl">
            GEO 不是给 AI 塞关键词，<br />而是让内容进入检索与引用的链路。
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-muted">
            生成式引擎先用查询去检索网页，再把片段放进上下文，最后生成带来源的答案。能被稳定引用，取决于三层条件：抓得到、读得懂、值得信。
          </p>
          <a href="/knowledge/what-is-geo/" class="btn btn-ghost mt-6">什么是 GEO？完整技术介绍 →</a>
        </div>
        <ol class="grid grid-cols-2 gap-2 sm:grid-cols-4">
          {
            pipeline.map((step, index) => (
              <li class="relative rounded-lg border border-line bg-canvas px-3 py-4">
                <span class="font-mono text-[10px] text-brand-500">{String(index + 1).padStart(2, '0')}</span>
                <p class="mt-1.5 text-[13px] font-medium leading-snug text-ink">{step}</p>
                {index < pipeline.length - 1 && (
                  <span class="absolute -right-1.5 top-1/2 hidden -translate-y-1/2 font-mono text-[10px] text-line-strong sm:block">
                    →
                  </span>
                )}
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- 最新知识 -->
  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <SectionHeader
      eyebrow="Knowledge"
      title="最新技术文章"
      description="每条结论标注证据等级：官方文档、论文、自有实验或技术分析。"
      link={{ href: '/knowledge/', label: '全部知识库' }}
    />
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {
        latestKnowledge.map((entry) => (
          <ArticleCard
            title={entry.data.title}
            description={entry.data.description}
            href={`/knowledge/${entry.id}/`}
            category={entry.data.category}
            date={entry.data.publishDate}
            evidence={entry.data.evidence}
            tags={entry.data.tags}
            readingTime={readingTime(entry)}
          />
        ))
      }
    </div>
  </section>

  <!-- 研究 + 案例 -->
  <section class="border-t border-line bg-surface">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
      <div class="grid gap-12 lg:grid-cols-[1.2fr_0.8fr]">
        <div>
          <SectionHeader
            eyebrow="Research"
            title="研究记录与实验报告"
            link={{ href: '/research/', label: '全部研究' }}
          />
          <ul class="mt-6 divide-y divide-line border-y border-line">
            {
              latestResearch.map((entry) => (
                <li>
                  <a href={`/research/${entry.id}/`} class="group flex flex-col gap-2 py-5 sm:flex-row sm:items-start sm:gap-6">
                    <span class="shrink-0 font-mono text-[10px] tracking-wide text-muted uppercase sm:w-24 sm:pt-1">
                      {entry.data.category}
                    </span>
                    <span class="flex-1">
                      <span class="block text-[15px] font-medium text-ink group-hover:text-brand-800">
                        {entry.data.title}
                      </span>
                      <span class="mt-1 block text-[13px] leading-relaxed text-muted">
                        {entry.data.description}
                      </span>
                    </span>
                    <span class="shrink-0 font-mono text-[10px] text-muted">→</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <SectionHeader eyebrow="Cases" title="案例记录" link={{ href: '/cases/', label: '全部案例' }} />
          <div class="mt-6 space-y-3">
            {
              latestCases.map((entry) => (
                <a
                  href={`/cases/${entry.id}/`}
                  class="block rounded-xl border border-line bg-canvas p-4 transition-colors hover:border-brand-300"
                >
                  <div class="flex items-center gap-2">
                    <span class="chip chip-brand !text-[11px]">{entry.data.category}</span>
                    {entry.data.site && (
                      <span class="truncate font-mono text-[10px] text-muted">{entry.data.site}</span>
                    )}
                  </div>
                  <p class="mt-2 text-sm font-medium leading-snug text-ink">{entry.data.title}</p>
                  <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-muted">
                    {entry.data.description}
                  </p>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 工具 -->
  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <SectionHeader
      eyebrow="Tools"
      title="在浏览器里验证，而不是相信结论"
      description="所有工具在本地运行，不上传你的文本；每个工具都写明它不能判断什么。"
      link={{ href: '/tools/', label: '进入工具箱' }}
    />
    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        TOOLS.slice(0, 6).map((tool) => (
          <a
            href={tool.href}
            class="group flex items-start gap-3 rounded-xl border border-line bg-canvas p-4 transition-all hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-[var(--shadow-card)]"
          >
            <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-md border border-line bg-surface font-mono text-[10px] text-brand-700">
              {tool.titleEn.slice(0, 2).toUpperCase()}
            </span>
            <span class="min-w-0">
              <span class="flex items-baseline gap-2">
                <span class="text-[13px] font-medium text-ink group-hover:text-brand-800">
                  {tool.title}
                </span>
                {tool.status === 'beta' && (
                  <span class="font-mono text-[9px] tracking-wide text-accent-600 uppercase">beta</span>
                )}
              </span>
              <span class="mt-1 block text-[12px] leading-relaxed text-muted">{tool.description}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- 方法论 -->
  <section class="bg-brand-900 text-brand-50">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
      <div class="grid gap-10 lg:grid-cols-[1fr_1fr]">
        <div>
          <p class="font-mono text-[10px] tracking-[0.18em] text-brand-300 uppercase">Method</p>
          <h2 class="display-title mt-3 text-2xl text-white sm:text-3xl">
            GEO 行业最缺的不是技巧，<br />而是证据。
          </h2>
          <p class="mt-4 max-w-lg text-sm leading-relaxed text-brand-100/80">
            GEO Lab 对每一条优化建议标注证据等级，公开测试条件，保留失败记录，并且不承诺任何 AI 引用结果。我们更愿意告诉你“这条结论有多强”，而不是“照做就能被引用”。
          </p>
          <a href="/about/#method" class="mt-6 inline-flex items-center gap-1.5 text-sm text-brand-200 hover:text-white">
            阅读研究方法论 <span aria-hidden="true">→</span>
          </a>
        </div>
        <ul class="grid gap-px overflow-hidden rounded-xl border border-white/15 bg-white/10 sm:grid-cols-2">
          {
            Object.entries(EVIDENCE_LEVELS).map(([key, level]) => (
              <li class="bg-brand-900 px-4 py-4">
                <p class="text-[13px] font-medium text-white">{level.label}</p>
                <p class="mt-1 text-[11px] leading-relaxed text-brand-100/70">{level.description}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
    <div class="rounded-2xl border border-line bg-surface p-8 sm:p-12">
      <div class="grid items-center gap-8 lg:grid-cols-[1fr_auto]">
        <div>
          <p class="eyebrow">Services</p>
          <h2 class="display-title mt-2 text-2xl sm:text-[1.9rem]">
            先诊断，再决定要不要优化。
          </h2>
          <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted">
            我们用同一套方法论检查你的站点：抓取与索引基础、内容可理解性、实体与结构化数据，最后才讨论 AI 可见性的测试方案。
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/services/" class="btn btn-primary">查看企业服务</a>
          <a href="/tools/site-audit/" class="btn btn-ghost">自己做一次诊断</a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
