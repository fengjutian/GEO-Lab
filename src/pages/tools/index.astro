---
import MainLayout from '@/layouts/MainLayout.astro';
import PageHeader from '@/components/common/PageHeader.astro';
import { TOOLS, TOOL_CATEGORIES } from '@/lib/tools/registry';
import { breadcrumbSchema } from '@/lib/schema/jsonld';

const schemas = [
  breadcrumbSchema([
    { name: '首页', url: '/' },
    { name: '工具箱', url: '/tools/' },
  ]),
];

const statusLabel = { stable: '可用', beta: 'Beta', planned: '规划中' } as const;
---

<MainLayout
  title="GEO 工具箱"
  description="浏览器端运行的 GEO 分析工具：网站诊断、Embedding 语义相似度、Chunking 切分实验、RAG 流程可视化、实体提取、JSON-LD 生成、内容结构分析。全部本地计算，不上传你的文本。"
  canonical="/tools/"
  schemas={schemas}
>
  <PageHeader
    eyebrow="Tools"
    title="GEO 工具箱"
    titleEn="Test the mechanism instead of trusting the claim."
    description="七个工具，覆盖诊断、实验、分析与生成。每个工具都写明它不能判断什么 —— 我们宁可让你知道边界，也不想给一个看起来很美但没有依据的分数。"
    crumb={[{ name: '工具箱', href: '/tools/' }]}
    stats={[
      { label: 'Tools', value: String(TOOLS.length) },
      { label: 'Runtime', value: 'Browser' },
    ]}
  />

  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
    <div class="grid gap-3 rounded-xl border border-brand-200 bg-brand-50 p-5 sm:grid-cols-[auto_1fr] sm:gap-5">
      <p class="font-mono text-[10px] tracking-[0.14em] text-brand-700 uppercase">使用原则</p>
      <p class="text-[13px] leading-relaxed text-brand-900/80">
        所有计算在浏览器内完成，页面不会上传你粘贴的文本、HTML 或 URL。工具给出的是结构与机制层面的观察，
        不是排名预测，也不是“AI 引用概率”。
      </p>
    </div>

    <section class="mt-12">
      <div class="flex flex-wrap items-baseline gap-3">
        <h2 class="display-title text-xl">全部工具</h2>
        <span class="font-mono text-[10px] tracking-wide text-muted uppercase">{TOOLS.length} tools</span>
        <div class="ml-auto flex flex-wrap gap-1.5">
          {
            TOOL_CATEGORIES.map((category) => (
              <span class="chip !text-[10px]">
                {category}
                <span class="font-mono text-muted">
                  {TOOLS.filter((tool) => tool.category === category).length}
                </span>
              </span>
            ))
          }
        </div>
      </div>

      <div class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {
          TOOLS.map((tool) => (
            <a
              href={tool.href}
              class="group flex flex-col rounded-[var(--radius-card)] border border-line bg-canvas p-5 transition-all hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-[var(--shadow-card)]"
            >
              <div class="flex items-center gap-2">
                <span class="chip chip-brand !text-[11px]">{tool.category}</span>
                <span
                  class:list={[
                    'font-mono text-[9px] tracking-wide uppercase',
                    tool.status === 'beta' ? 'text-accent-600' : 'text-muted',
                  ]}
                >
                  {statusLabel[tool.status]}
                </span>
              </div>
              <h3 class="mt-3 text-[16px] font-semibold leading-snug text-ink group-hover:text-brand-800">
                {tool.title}
              </h3>
              <p class="font-mono text-[10px] tracking-[0.1em] text-muted uppercase">{tool.titleEn}</p>
              <p class="mt-2 flex-1 text-[13px] leading-relaxed text-muted">{tool.description}</p>
              <p class="mt-4 border-t border-line pt-3 text-[11px] leading-relaxed text-ink-soft/70">
                <span class="font-mono text-[9px] tracking-[0.1em] text-muted uppercase">不做 · </span>
                {tool.limitations[0]}
              </p>
              <span class="mt-3 inline-flex items-center gap-1 text-[12px] font-medium text-brand-700">
                打开工具 <span class="transition-transform group-hover:translate-x-0.5">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="mt-16 rounded-2xl border border-line bg-surface p-8">
      <div class="grid items-center gap-6 lg:grid-cols-[1fr_auto]">
        <div>
          <p class="eyebrow">Roadmap</p>
          <h2 class="display-title mt-2 text-xl sm:text-2xl">接下来补什么</h2>
          <ul class="mt-3 grid gap-2 text-[13px] text-muted sm:grid-cols-2">
            <li>· Robots 与 Sitemap 分析器（需要服务端抓取）</li>
            <li>· Citation Tracker：记录 AI 回答的引用来源</li>
            <li>
              · 可见性监测工作台：已上线，见
              <a href="/benchmark/" class="text-brand-700 link-underline">/benchmark/</a>
            </li>
            <li>· 同一问题集并行对比多个模型端点</li>
          </ul>
        </div>
        <a href="/services/" class="btn btn-primary shrink-0">需要人工诊断？</a>
      </div>
    </section>
  </div>
</MainLayout>
