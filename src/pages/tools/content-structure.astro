---
import ToolLayout from '@/layouts/ToolLayout.astro';
import ContentAnalyzer from '@/features/content-analyzer/ContentAnalyzer';
import { findTool } from '@/lib/tools/registry';

const tool = findTool('content-structure')!;
---

<ToolLayout
  tool={tool}
  reading={[
    '关注「评分」下方未通过的具体条目，而不是总分。总分只是便于沟通的汇总，改哪一条才是重点。',
    '平均段长与平均句长是两个最容易被忽略的指标：结构问题往往不是缺标题，而是段落太长导致无法切分。',
    '「数字表达」与「外链」为 0 时，内容很难被判断为可核验。这不是要求堆数据，而是要求给出处。',
    '把同一段内容用两种写法各跑一次，对比评分差异 —— 这也是本站案例库里的改写实验方法。',
  ]}
  method={[
    {
      title: '评分由哪些规则组成',
      body: '八条规则，权重从 8 到 18 分：标题层级、平均段长、平均句长、列表/表格、数字与来源、问句式小节、正文长度、超长段落。每条按通过与否计入权重，满分 100。规则的选择基于“片段可被单独摘取”这一目标，而不是任何搜索引擎的评分标准。',
    },
    {
      title: '为什么这只是一个启发式',
      body: '结构特征与引用概率之间没有已证实的映射关系。短段落、小标题、列表之所以被认为有用，是因为它们让内容更容易被切分与摘取 —— 这是机制层面的推断，不是统计结论。工具能做的是把可改的结构问题暴露出来，而不是预测结果。',
    },
    {
      title: '结构之上还有什么',
      body: '原创数据、可复现的实验、明确的作者与机构、可核验的来源链接 —— 这些是结构评分完全覆盖不到的部分，也是决定内容是否值得被引用的核心。结构优化能让好内容更容易被发现，但不能让空内容变得有价值。',
    },
  ]}
>
  <ContentAnalyzer client:load />
</ToolLayout>
