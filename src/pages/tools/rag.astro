---
import ToolLayout from '@/layouts/ToolLayout.astro';
import RagPlayground from '@/features/rag-playground/RagPlayground';
import { findTool } from '@/lib/tools/registry';

const tool = findTool('rag')!;
---

<ToolLayout
  tool={tool}
  reading={[
    '看「召回与重排」：左侧数字是 BM25 分数，右侧是加入词元覆盖率后的重排分数。两者排序不同时，说明重排真的改变了结果。',
    '把 topK 从 4 降到 1：上下文只剩一个片段，答案会变得单薄。这就是召回不足的典型表现。',
    '把 token 预算调低到 200：部分片段干脆进不了上下文。真实系统里，预算不足是“内容存在但没被用上”的常见原因。',
    '注意答案中的上标编号：它对应下面的上下文块。编号错乱意味着引用归因错误，这比不引用更糟。',
  ]}
  method={[
    {
      title: '演示实现了什么',
      body: '八条内置语料先做分词，再用 BM25 打分召回前 6 条；重排阶段结合查询词元覆盖率与位置加权；上下文阶段按预算依次装配最多 3 个片段；生成阶段从每个片段中抽取与查询词元重叠最多的句子，并附上来源编号。整条链路是确定性的，方便你反复对比参数。',
    },
    {
      title: '刻意没有做的事',
      body: '没有调用任何大模型。抽取式摘要不是生成式回答：真实模型会重组、概括，也可能忽略片段或错误归因。这个取舍是为了让机制可见 —— 你能看到每一句答案来自哪个片段，而不是面对一个无法解释的黑箱输出。',
    },
    {
      title: '从演示到真实系统',
      body: '真实 RAG 系统会加入向量召回、混合检索、查询改写与多轮检索，并用更大的重排模型排序。但核心约束没有变：片段必须先被召回，才有资格进入上下文；进入上下文之后，还要与查询足够相关，才可能被引用。',
    },
  ]}
>
  <RagPlayground client:load />
</ToolLayout>
