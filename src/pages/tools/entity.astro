---
import ToolLayout from '@/layouts/ToolLayout.astro';
import EntityExtractor from '@/features/entity-extractor/EntityExtractor';
import { findTool } from '@/lib/tools/registry';

const tool = findTool('entity')!;
---

<ToolLayout
  tool={tool}
  reading={[
    '先看「组织 / 品牌」：如果正文里出现了公司名但这里没有识别出来，说明名称没有被写成可识别的形式（全称、法定后缀或与 sameAs 一致的写法）。',
    '再看「技术与术语」：这些是你希望被关联到页面的领域词。术语过少，页面很难被判断所属领域。',
    '重点看右侧的覆盖检查。定义句与组织实体是两个最常被忽略的项 —— 技术文章尤其容易只写结论、不写“X 是什么”。',
    '指代词统计不是要求清零。判断标准是：把任意一段单独摘出来，读者还能不能知道“它”指谁。',
  ]}
  method={[
    {
      title: '规则与词表能做到什么',
      body: '抽取使用三类信号：法定后缀与机构词（公司、研究院、University 等）、称谓与引述结构（作者、教授、由…提出）、以及领域术语词表。这套规则对中文技术文档的召回尚可，但无法处理未登录专有名词、跨语言别名与代词消解。',
    },
    {
      title: '为什么不做关系抽取',
      body: '关系抽取需要句法分析与领域本体，规则法在复杂句上错误率很高。与其给出一个不可靠的“关系图”，不如只报告实体与共现，让使用者自己判断。真实的实体关系应写在 JSON-LD 或知识图谱里，而不是从行文中猜。',
    },
    {
      title: '实体与引用之间的关系',
      body: '检索系统需要判断“这个页面在讲哪个实体”。页面中稳定的实体名、明确类型（组织/人物/产品）与外部身份链接（sameAs），会显著降低判断成本。反之，通篇使用“我们”“该产品”而不给出正式名称，页面在脱离站点上下文后几乎无法被正确归属。',
    },
  ]}
>
  <EntityExtractor client:load />
</ToolLayout>
