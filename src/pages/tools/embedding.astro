---
import ToolLayout from '@/layouts/ToolLayout.astro';
import EmbeddingLab from '@/features/embedding-lab/EmbeddingLab';
import { findTool } from '@/lib/tools/registry';

const tool = findTool('embedding')!;
---

<ToolLayout
  tool={tool}
  reading={[
    '余弦相似度的取值范围是 -1 到 1，但实际文本向量多集中在 0 到 1 之间；0.5 并不等于“合格”。阈值必须按模型和语料重新校准。',
    '观察右侧的“共享词元”：相似度高的两个句子会共享较多子词。当两个句子意思相同但用词完全不同时，本演示的得分会明显下降。',
    '把维度从 256 调到 128，会看到哈希碰撞增加、区分度下降 —— 这是维度与信息容量之间的真实取舍。',
  ]}
  method={[
    {
      title: '哈希向量化是怎么工作的',
      body: '先把文本切成英文词与中文二元组，过滤停用词；再对每个词元计算 FNV-1a 哈希，映射到固定维度的桶里并做次线性频率缩放（1 + log tf），最后做 L2 归一化。两个向量点积即余弦相似度。这是信息检索里的经典特征哈希，被广泛用于轻量文本匹配。',
    },
    {
      title: '与神经嵌入模型的差别',
      body: '神经嵌入模型在海量语料上训练，把语义相近的文本映射到相近位置，因此能识别同义词、改写与跨语言对应。哈希向量只识别字面与子词重叠，完全不知道“GEO”和“生成式引擎优化”是同一件事。理解这个差别，也就理解了为什么单纯堆砌关键词不会提升语义相关性。',
    },
    {
      title: '这对 GEO 意味着什么',
      body: '检索系统用嵌入衡量“这段内容与查询是否讲同一件事”。所以你需要在页面里同时出现同义表述、完整定义与具体实例，而不是反复重复一个词。内容覆盖一个概念的多种表达方式时，被不同查询命中的概率才会上升。',
    },
  ]}
>
  <EmbeddingLab client:load />
</ToolLayout>
