---
import MainLayout from '@/layouts/MainLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import { softwareApplicationSchema, breadcrumbSchema } from '@/lib/schema/jsonld';
import type { ToolDefinition } from '@/lib/tools/registry';
import { TOOLS } from '@/lib/tools/registry';
import { getKnowledge } from '@/lib/content/queries';

type Props = {
  tool: ToolDefinition;
  /** 结果应该怎么读，写在工具下方而不是藏起来 */
  reading: string[];
  method: { title: string; body: string }[];
};

const { tool, reading, method } = Astro.props;
const siblings = TOOLS.filter((item) => item.slug !== tool.slug).slice(0, 4);
const knowledge = await getKnowledge();
const relatedArticles = tool.related
  .map((id) => knowledge.find((entry) => entry.id === id))
  .filter((entry): entry is (typeof knowledge)[number] => Boolean(entry))
  .map((entry) => ({ title: entry.data.title, href: `/knowledge/${entry.id}/` }));

const schemas = [
  softwareApplicationSchema({
    name: tool.title,
    description: tool.description,
    url: tool.href,
    category: 'WebApplication',
  }),
  breadcrumbSchema([
    { name: '首页', url: '/' },
    { name: '工具箱', url: '/tools/' },
    { name: tool.title, url: tool.href },
  ]),
];
---

<MainLayout
  title={tool.title}
  description={`${tool.description} ${tool.limitations[0] ?? ''}`}
  canonical={tool.href}
  schemas={schemas}
>
  <section class="border-b border-line bg-surface">
    <div class="mx-auto max-w-6xl px-5 pt-8 pb-10 sm:px-8">
      <Breadcrumbs items={[{ name: '工具箱', href: '/tools/' }, { name: tool.title }]} />
      <div class="mt-6 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <div class="flex flex-wrap items-center gap-2">
            <span class="chip chip-brand">{tool.category}</span>
            <span class="chip">{tool.runtime === 'browser' ? '浏览器端运行' : '需要服务端'}</span>
            {tool.status === 'beta' && <span class="chip chip-accent">beta</span>}
          </div>
          <h1 class="display-title mt-4 text-3xl sm:text-4xl">{tool.title}</h1>
          <p class="mt-1 font-mono text-[11px] tracking-[0.14em] text-muted uppercase">{tool.titleEn}</p>
          <p class="lede mt-4">{tool.description}</p>
        </div>
        <div class="shrink-0 rounded-xl border border-line bg-canvas p-4 lg:max-w-xs">
          <p class="font-mono text-[10px] tracking-[0.12em] text-accent-600 uppercase">能力边界</p>
          <ul class="mt-2 space-y-1.5 text-[11px] leading-relaxed text-muted">
            {tool.limitations.map((limitation) => <li>· {limitation}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-5 py-8 sm:px-8">
    <slot />

    <div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_280px]">
      <section class="prose">
        <h2>如何解读结果</h2>
        <ol>
          {reading.map((item) => <li>{item}</li>)}
        </ol>

        {
          method.map((section) => (
            <>
              <h2>{section.title}</h2>
              <p>{section.body}</p>
            </>
          ))
        }
      </section>

      <aside class="space-y-4">
        {
          relatedArticles.length > 0 && (
            <div class="rounded-xl border border-line p-4">
              <p class="eyebrow">先读这个</p>
              <ul class="mt-2 space-y-2">
                {relatedArticles.map((article) => (
                  <li>
                    <a href={article.href} class="text-[13px] leading-snug text-ink-soft hover:text-brand-700">
                      {article.title} →
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <div class="rounded-xl border border-line bg-surface p-4">
          <p class="eyebrow">其它工具</p>
          <ul class="mt-2 space-y-2">
            {
              siblings.map((item) => (
                <li>
                  <a href={item.href} class="text-[13px] text-ink-soft hover:text-brand-700">
                    {item.title}
                  </a>
                </li>
              ))
            }
          </ul>
          <a href="/tools/" class="mt-3 inline-block text-xs text-brand-700 link-underline">全部工具 →</a>
        </div>
      </aside>
    </div>
  </div>
</MainLayout>
